{
  "name": "nestjs",
  "private": true,
  "version": "1.0.0",
  "description": "Create a new node api, using NestJS",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prettier": "prettier src/* --check",
    "prettier:fix": "prettier src/* --write",
    "patch": "npm version patch -m \"release: version %s\" && git push --tags && git push",
    "postversion": "bash ./scripts.sh sonar",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug=0.0.0.0 --watch",
    "test": "NODE_ENV=test jest --detectOpenHandles --forceExit --coverage --maxWorkers=50% --silent"
  },
  "os": [
    "darwin",
    "linux",
    "!win32"
  ],
  "engines": {
    "node": "22",
    "npm": "11"
  },
  "keywords": [
    "scafflater",
    "templater",
    "scaffold"
  ],
  "author": "Grupo Boticário",
  "license": "ISC",
  "dependencies": {
    "@nestjs/class-transformer": "^0.4.0",
    "@nestjs/class-validator": "^0.13.4",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/terminus": "^11.0.0",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fastify/static": "^8.3.0",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/testing": "^11.1.9",
    "@tsconfig/node22": "^22.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grupoboticario/alquimia-template-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/grupoboticario/alquimia-template-typescript/issues"
  },
  "homepage": "https://github.com/grupoboticario/alquimia-template-typescript#readme"
}