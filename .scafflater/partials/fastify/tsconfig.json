{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.js", "node_modules", "src/**/*.test.ts"]
}
