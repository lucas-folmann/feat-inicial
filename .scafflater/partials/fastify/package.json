{
  "name": "fastify",
  "private": true,
  "version": "1.0.0",
  "description": "Create a new Typescript API using Fastify",
  "main": "./src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:dev": "tsc -p tsconfig.json && tsc -w & node --watch dist/src/index.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prettier": "prettier src/* --check",
    "prettier:fix": "prettier src/* --write",
    "patch": "npm version patch -m \"release: version %s\" && git push --tags && git push",
    "test": "NODE_ENV=test jest --detectOpenHandles --forceExit --coverage --maxWorkers=50% --silent"
  },
  "os": [
    "darwin",
    "linux",
    "!win32"
  ],
  "engines": {
    "node": "22",
    "npm": "11"
  },
  "keywords": [
    "scafflater",
    "templater",
    "scaffold"
  ],
  "author": "Grupo Boticário",
  "license": "ISC",
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.6.1",
    "dnscache": "^1.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fs-extra": "^11.3.2",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "workspaces": [
    ".scafflater/extension",
    ".scafflater/helpers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grupoboticario/alquimia-template-typescript-k8s.git"
  },
  "bugs": {
    "url": "https://github.com/grupoboticario/alquimia-template-typescript-k8s/issues"
  },
  "homepage": "https://github.com/grupoboticario/alquimia-template-typescript-k8s#readme"
}